<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".FiltroDialogFragment"
    android:layout_margin="10dp"
    >

    <androidx.cardview.widget.CardView
        android:layout_margin="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/boxBg"
        app:cardCornerRadius="30dp">

        <LinearLayout
            android:layout_margin="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/TextBold"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="Visualizar: " />

            <RadioGroup
                android:id="@+id/radioGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="20dp"
                >

                <RadioButton
                    android:id="@+id/radioTodos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Todos os lembretes"
                    />

                <RadioButton
                    android:id="@+id/radioManha"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Lembretes da manhã (6:00 - 12:00)"/>

                <RadioButton
                    android:id="@+id/radioTarde"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Lembretes da tarde (12:00 - 18:00)"/>

                <RadioButton
                    android:id="@+id/radioNoite"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Lembretes da noite (18:00 - 6:00)"  />

            </RadioGroup>

            <Button
                android:id="@+id/btnApply"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/primariaClaro"
                android:text="Apply"
                android:textColor="@color/white"/>

        </LinearLayout>

    </androidx.cardview.widget.CardView>




</RelativeLayout>